<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GodotProjectDir>./</GodotProjectDir>
    <AssemblyName>TimeToGo</AssemblyName>
    <RootNamespace>TimeToGo</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep export artifacts and temporary capture project sources out of the main build. -->
    <Compile Remove="build/**/*.cs" />
  </ItemGroup>
</Project>
